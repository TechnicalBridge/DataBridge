<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Este servicio se compila solo: su padre es el de Spring Boot, no un pom del
    repositorio, y fija aqui sus propias versiones.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.tbridge</groupId>
  <artifactId>tbridge-ms-debt</artifactId>
  <version>1.0.0</version>
  <name>MS-Debt</name>

  <properties>
    <java.version>25</java.version>
    <!-- Al programar: el perfil que lee el .env. Docker corre el jar, sin perfil. -->
    <spring-boot.run.profiles>dev</spring-boot.run.profiles>
    <jmeter-java-dsl.version>2.3</jmeter-java-dsl.version>
    <!-- mvnw test corre lo de siempre, sin Docker. Los otros tipos, con su perfil, mas abajo. -->
    <pruebas.grupos></pruebas.grupos>
    <pruebas.excluidos>integracion,seguridad,rendimiento</pruebas.excluidos>
    <pruebas.reportes>${project.build.directory}/surefire-reports</pruebas.reportes>
    <!-- La rama 2.8 es la de Spring Boot 3.5; la 3.x ya es para Spring Boot 4. -->
    <springdoc.version>2.9.1</springdoc.version>
  </properties>

  <dependencies>
    <!-- Verifica sesiones ES256 con publicas de auth; sin llave de firma. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-hateoas</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- MySQL y Flyway en vez de H2 con ddl-auto. Ver docs/base-de-datos. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>2.4.0</version>
    </dependency>
    <!-- La planilla de la cartera en Excel: la plantilla y leer la que sube la empresa. -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.5.1</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Un MySQL de verdad en un contenedor, para las pruebas de integracion, seguridad y rendimiento. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Pruebas de carga en Java, como una prueba mas de JUnit. -->
    <dependency>
      <groupId>us.abstracta.jmeter</groupId>
      <artifactId>jmeter-java-dsl</artifactId>
      <version>${jmeter-java-dsl.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>${pruebas.grupos}</groups>
          <excludedGroups>${pruebas.excluidos}</excludedGroups>
          <reportsDirectory>${pruebas.reportes}</reportsDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Que tipo de prueba corre: mvnw test -Pintegracion. Lo que no tiene @Tag es lo de siempre. -->
  <profiles>
    <profile>
      <id>integracion</id>
      <properties>
        <pruebas.grupos>integracion</pruebas.grupos>
        <pruebas.excluidos></pruebas.excluidos>
        <pruebas.reportes>${project.build.directory}/surefire-integracion</pruebas.reportes>
      </properties>
    </profile>
    <profile>
      <id>seguridad</id>
      <properties>
        <pruebas.grupos>seguridad</pruebas.grupos>
        <pruebas.excluidos></pruebas.excluidos>
        <pruebas.reportes>${project.build.directory}/surefire-seguridad</pruebas.reportes>
      </properties>
    </profile>
    <profile>
      <id>rendimiento</id>
      <properties>
        <pruebas.grupos>rendimiento</pruebas.grupos>
        <pruebas.excluidos></pruebas.excluidos>
        <pruebas.reportes>${project.build.directory}/surefire-rendimiento</pruebas.reportes>
      </properties>
    </profile>
    <!-- Lo que corre la CI ademas de lo de siempre. Rendimiento no: depende de la maquina. -->
    <profile>
      <id>con-docker</id>
      <properties>
        <pruebas.grupos>integracion,seguridad</pruebas.grupos>
        <pruebas.excluidos></pruebas.excluidos>
        <pruebas.reportes>${project.build.directory}/surefire-con-docker</pruebas.reportes>
      </properties>
    </profile>
  </profiles>
</project>
