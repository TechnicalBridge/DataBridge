# Copiar fuera del repositorio como .env.proveedores y completar en privado.
# No incluir MYSQL_*, RABBIT_*, JWT_SECRET, INTERNAL_KEY, CIFRADO_LLAVE ni WEBHOOK_SECRET.
# No pegar el documento de credenciales entero: solo las variables elegidas.
BREVO_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=DataBridge
ADMIN_CORREO=

# Obligatorio con datos de demo y un proveedor real. Completar uno o ambos.
CORREO_SOLO_A=
CORREO_DESVIAR_A=

# Alternativa a Brevo: completar SMTP solo si se eligio ese proveedor.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true

# Incluir solo las pasarelas y cuentas de prueba verificadas.
# KHIPU_LLAVE=
# KHIPU_SECRETO=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_ENVIRONMENT=TEST

# Opcional: cuenta BDE del Banco Central. Incluir ambos campos juntos.
# BCENTRAL_USER=
# BCENTRAL_PASS=

# Opcional: IA de la cascada del PR #214, solo con codigo/Compose compatibles.
# No genera llaves ni verifica modelos. No incluir si se comparte solo correo/Khipu.
# LLM_ORDEN=ollama,groq,gemini
# LLM_ENFRIAMIENTO_MINUTOS=60
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=modelo_instalado_localmente
# OLLAMA_TIMEOUT=60
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=modelo_habilitado_en_tu_cuenta
# GROQ_TIMEOUT=30
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=modelo_habilitado_en_tu_cuenta
# GEMINI_TIMEOUT=30
